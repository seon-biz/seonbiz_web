---
import '@/src/styles/globals.css';
import { SiteHeader, SiteFooter } from '@/components/site/shell';

interface Props {
  title?: string | { absolute: string };
  description?: string;
  robots?: { index?: boolean; follow?: boolean };
}
const { title, description = '홈페이지부터 상품 홍보까지, 내 사업에 필요한 일을 AI로 직접 해보세요. 쇼핑몰·서비스업을 위한 일대일 실무 코칭. 첫 상담은 1시간 무료입니다.', robots } = Astro.props;
const pageTitle = typeof title === 'object' ? title.absolute : title ? `${title} | 세온비즈` : '세온비즈 · 쇼핑몰·서비스업 일대일 AI 코칭';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {robots && <meta name="robots" content={`${robots.index === false ? 'noindex' : 'index'}, ${robots.follow === false ? 'nofollow' : 'follow'}`} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon-seonbiz-approved-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-seonbiz-approved-192.png" sizes="192x192" type="image/png" />
    <link rel="shortcut icon" href="/favicon-seonbiz-approved-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-seonbiz-approved.png" sizes="180x180" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 바로가기</a>
    <SiteHeader client:load pathname={Astro.url.pathname} />
    <slot />
    <SiteFooter />
    <script>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(entries => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          }
        }, { threshold: 0.12 });
        document.querySelectorAll('[data-reveal]').forEach(element => {
          // Hydrated React islands start their own animation after mounting.
          if (element.closest('astro-island')) return;
          element.classList.add('reveal-ready');
          observer.observe(element);
        });
      }
    </script>
  </body>
</html>
