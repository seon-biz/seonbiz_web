---
import '@/src/styles/globals.css';
import { SiteHeader, SiteFooter } from '@/components/site/shell';

interface Props {
  title?: string | { absolute: string };
  description?: string;
  image?: string;
  robots?: { index?: boolean; follow?: boolean };
}
const { title, description = '웹사이트를 직접 만들고 관리하려는 분을 위한 홈페이지 AI 코칭. 제작·수정, SEO·AI 검색 최적화, GA4·서치콘솔 데이터 분석을 함께합니다.', image = '/images/service-website.webp', robots } = Astro.props;
const pageTitle = typeof title === 'object' ? title.absolute : title ? `${title} | 세온비즈` : '세온비즈 · 홈페이지 일대일 AI 코칭';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL(image, canonicalUrl);
const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbNames: Record<string, string> = { coaching: '코칭 안내', website: '홈페이지 코칭', process: '진행·비용', cases: '실제 사례', notes: '코칭 노트', about: '소개', apply: '무료 상담 신청', privacy: '개인정보처리방침' };
const breadcrumbItems = [{ name: '홈', url: new URL('/', canonicalUrl).toString() }, ...pathParts.map((part, index) => ({ name: breadcrumbNames[part] ?? pageTitle, url: new URL(`/${pathParts.slice(0, index + 1).join('/')}`, canonicalUrl).toString() }))];
const organization = { '@type': 'Organization', name: '세온비즈', url: 'https://seonbiz.com', email: 'cobaltblue872@gmail.com', logo: 'https://seonbiz.com/favicon-seonbiz-approved-192.png', founder: { '@type': 'Person', name: '서정옥' } };
const structuredData = [
  { '@context': 'https://schema.org', ...organization },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: '세온비즈', url: 'https://seonbiz.com', publisher: { '@id': 'https://seonbiz.com/#organization' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbItems.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: item.url })) },
  ...(Astro.url.pathname.startsWith('/coaching/') ? [{ '@context': 'https://schema.org', '@type': 'Service', name: pageTitle, description, serviceType: '일대일 AI 실무 코칭', provider: organization, areaServed: '대한민국', url: canonicalUrl.toString() }] : []),
  ...((Astro.url.pathname.startsWith('/notes/') || Astro.url.pathname.startsWith('/cases/')) ? [{ '@context': 'https://schema.org', '@type': 'Article', headline: pageTitle, description, author: { '@type': 'Person', name: '서정옥' }, publisher: organization, mainEntityOfPage: canonicalUrl.toString(), image: socialImageUrl.toString() }] : []),
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="lUENxc0tDvHy_ErujaXYe4ObK39RinvS9QBsXeK5Jo4" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="세온비즈" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="세온비즈 AI 코칭 안내" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {robots && <meta name="robots" content={`${robots.index === false ? 'noindex' : 'index'}, ${robots.follow === false ? 'nofollow' : 'follow'}`} />}
    <meta name="generator" content={Astro.generator} />
    {Astro.url.pathname === '/' && <link rel="preload" as="image" href="/images/service-website.webp" type="image/webp" fetchpriority="high" />}
    <link rel="icon" href="/favicon-seonbiz-approved-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-seonbiz-approved-192.png" sizes="192x192" type="image/png" />
    <link rel="shortcut icon" href="/favicon-seonbiz-approved-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-seonbiz-approved.png" sizes="180x180" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 바로가기</a>
    <SiteHeader client:load pathname={Astro.url.pathname} />
    <slot />
    <SiteFooter />
    <script>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(entries => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          }
        }, { threshold: 0.12 });
        document.querySelectorAll('[data-reveal]').forEach(element => {
          // Hydrated React islands start their own animation after mounting.
          if (element.closest('astro-island')) return;
          element.classList.add('reveal-ready');
          observer.observe(element);
        });
      }
    </script>
  </body>
</html>
