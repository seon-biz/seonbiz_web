---
import SiteLayout from "@/src/layouts/SiteLayout.astro";
import { ArrowUpRight } from "lucide-react";
import { notes } from "@/lib/content";
import { PageHero } from "@/components/site/page-hero";
const metadata = {title: { absolute: '홈페이지·SEO·AI 활용 가이드 | 세온비즈 코칭 노트' },description: '홈페이지 제작과 운영, SEO·AI 검색 최적화, 콘텐츠 채널 자동화와 광고 데이터 확인 방법을 정리했습니다.'};
---
<SiteLayout {...metadata}>
<main id="main" class="notes-page"><PageHero eyebrow="코칭 노트" title={'직접 만들고 운영할 때\n참고하세요.'} intro={'홈페이지 제작과 수정, SEO·AI 검색 최적화, 콘텐츠 채널 운영에 필요한 내용을 정리했습니다.\n\n블로그·SNS·유튜브 숏츠로 확장하는 AI 작업 흐름과 실제 데이터를 확인하는 방법도 함께 다룹니다.'} image="/images/content-formats.webp" alt="홈페이지의 설명을 블로그와 SNS 게시물, 세로 영상으로 확장하는 콘텐츠 운영 과정" caption="홈페이지에서 여러 채널의 콘텐츠까지" cta={false}/><section class="container note-list" aria-label="코칭 노트 글 목록">{notes.map((note,i)=><a href={'/notes/'+note.slug}><span class="note-order">{String(i+1).padStart(2,'0')}</span><div><p class="kicker">{note.tag}</p><h2>{note.title}</h2><p class="note-excerpt">{note.intro}</p><time datetime="2026-09-17">2026.09.17</time></div><ArrowUpRight size={25} aria-hidden="true"/></a>)}</section><section class="container notes-consult" aria-label="무료 상담 안내"><p>홈페이지와 채널 운영에 적용해보고 싶으시면<br/>첫 상담에서 지금 상황을 함께 살펴봅니다.</p><a class="button button-ink" href="/apply">1시간 무료 상담 신청 <ArrowUpRight size={20} aria-hidden="true"/></a></section></main>
</SiteLayout>
