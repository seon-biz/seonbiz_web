---
import SiteLayout from "@/src/layouts/SiteLayout.astro";
import { ArrowRight } from "lucide-react";
import { notes } from "@/lib/content";
export const prerender = true;
export function getStaticPaths(){return notes.map(item=>({params:{slug:item.slug}}));}
const {slug}=Astro.params;
const note = notes.find((item) => item.slug === slug);
if(!note)throw new Error("Unknown note route");
const metadata={title:note.metaTitle??note.title,description:note.metaDescription??note.intro};
---
<SiteLayout {...metadata}>
<main id="main"><header class="article-header"><a href="/notes" class="back-link">코칭 노트</a><p class="eyebrow">{note.tag}</p><h1 class="balanced-note-title">{note.title}</h1><p class="article-meta">세온비즈 · <time datetime={note.publishedAt}>{note.publishedLabel}</time></p></header><article class="article-body"><p class="article-intro">{note.intro}</p>{note.sections.map(([title,...paragraphs],i)=><section><span class="step-index">{String(i+1).padStart(2,'0')}</span><h2>{title}</h2>{paragraphs.map(paragraph=><p>{paragraph}</p>)}</section>)}{note.source&&<p class="source-note">함께 참고할 자료: <a href={note.source.href} target="_blank" rel="noopener noreferrer">{note.source.label}</a></p>}<div class="article-next"><p>코칭 안내와 실제 데이터도 함께 확인해보세요.</p><a class="text-link" href={note.relatedHref}>{note.relatedLabel}<ArrowRight size={18}/></a><a class="text-link website-process-link" href="/process">진행 방식과 비용 확인하기 <ArrowRight size={18}/></a></div></article></main>
</SiteLayout>
