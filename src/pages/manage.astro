---
import SiteLayout from "@/src/layouts/SiteLayout.astro";
import { businessTypeLabel } from '@/lib/application-options';
import { database } from '@/db/raw';
import { isAdmin } from '@/lib/server/manage-auth';
import { ManageLogin,Logout,DeleteApplication } from '@/components/site/manage';
export const prerender=false;
const metadata={title:'상담 접수 관리',robots:{index:false,follow:false}};
const allowed=await isAdmin(Astro.request);
Astro.response.headers.set('Cache-Control','private, no-store');
let rows:Record<string,unknown>[]=[];
let error=false;
try{if(allowed)rows=(await database().prepare('SELECT id, business_type, website, problem, ai_usage, phone, created_at FROM applications ORDER BY created_at DESC LIMIT 100').all()).results}catch{error=true}
---
<SiteLayout {...metadata}>
{allowed ? (<main id="main" class="container section manage-page"><div class="manage-heading"><div><p class="eyebrow">세온비즈 운영</p><h1>상담 접수 내역</h1></div><Logout client:load/></div><p>최근 신청 100건을 표시합니다. 상담 완료·신청 철회 여부를 확인하고 목적을 달성한 정보는 지체 없이 삭제해 주세요. 연락이 끊긴 신청도 정기적으로 확인해 불필요하게 보관하지 않습니다.</p>{error?<p role="alert" class="form-error">접수 내역을 불러오지 못했습니다. 잠시 후 다시 확인해 주세요.</p>:rows.length===0?<p class="empty-state">아직 접수된 상담 신청이 없습니다.</p>:rows.map(r=><article class="application-record" ><div><strong>{String(r.phone)}</strong><span class="meta">{new Date(Number(r.created_at)).toLocaleString('ko-KR',{timeZone:'Asia/Seoul'})}</span></div><h2>하시는 일</h2><p>{businessTypeLabel(r.business_type)}</p>{r.website?<a href={String(r.website)} target="_blank" rel="noopener noreferrer" class="text-link">{String(r.website)}</a>:<p class="meta">사이트 주소 미입력</p>}<h2>상담하고 싶은 내용</h2><p>{String(r.problem)}</p><h2>AI 사용 경험</h2><p>{String(r.ai_usage)}</p><DeleteApplication client:load id={String(r.id)}/></article>)}</main>) : (<main id="main" class="container section manage-page"><p class="eyebrow">세온비즈 운영</p><h1>상담 접수 관리</h1><ManageLogin client:load /></main>)}
</SiteLayout>
