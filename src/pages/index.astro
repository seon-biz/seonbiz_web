---
import SiteLayout from "@/src/layouts/SiteLayout.astro";
import { ArrowUpRight } from "lucide-react";
import { WorkShowcase } from "@/components/site/sections";
import { Method, Pricing, FAQ, ConsultCTA, ScopeList } from "@/components/site/coaching-blocks";
import { Hero } from "@/components/site/hero";
import { ContentFormats, TrustBanner, homeFaqAdditions } from "@/components/site/home-sections";
const metadata={
  title: { absolute: '홈페이지 AI 코칭 | 세온비즈' },
  description: '웹사이트를 직접 만들고 관리하려는 분을 위한 일대일 AI 코칭. 홈페이지 제작·수정, 콘텐츠, 검색과 AI 추천을 위한 정보 정리, GA4·서치콘솔 데이터 확인을 함께합니다.',
};
---
<SiteLayout {...metadata}>
<main id="main"><Hero client:load/><TrustBanner/>
<section id="coaching" class="container section audience"><div class="section-heading"><p class="eyebrow">홈페이지 AI 코칭</p><h2>만드는 일부터<br/>직접 운영하는 방법까지</h2><p>새 홈페이지를 만들거나 현재 웹사이트를 고치고,<br/>검색과 AI 서비스가 참고할 정보를 정리합니다.</p></div><div class="audience-links"><a href="/coaching/website" class="audience-link"><span class="audience-number">01</span><div><h3>홈페이지 제작·수정</h3><p>사업과 서비스를 정확하게 설명하고,<br/>문의하기 쉬운 화면을 함께 만듭니다.</p></div><ArrowUpRight/></a><a href="/coaching/website" class="audience-link"><span class="audience-number">02</span><div><h3>SEO·GEO·데이터 분석</h3><p>검색과 AI 추천의 기반을 정리하고,<br/>GA4·서치콘솔 기록으로 다음 작업을 정합니다.</p></div><ArrowUpRight/></a></div></section>
<ScopeList/><ContentFormats/><WorkShowcase client:load/><Method showSessionExample/><Pricing/><FAQ client:load subset={[0,1,2,3,4,5,7,8]} additions={homeFaqAdditions}/>
<section class="container section home-notes"><div><p class="eyebrow">코칭 노트</p><h2>직접 해보실 때<br/>참고하세요.</h2></div><div><a href="/notes/website-or-agency">홈페이지를 맡길까, 직접 만들까 <ArrowUpRight size={20}/></a><a href="/notes/content-formats">홈페이지 내용을 블로그·SNS·숏츠로 확장하기 <ArrowUpRight size={20}/></a><a href="/notes/ai-search-basics">AI 검색을 준비하려면 무엇부터 고칠까요? <ArrowUpRight size={20}/></a><a href="/notes/read-ad-numbers">광고 관리 화면에서 무엇부터 봐야 할까요? <ArrowUpRight size={20}/></a><a href="/notes" class="text-link">코칭 노트 모두 보기</a></div></section><ConsultCTA/>
</main>
</SiteLayout>
