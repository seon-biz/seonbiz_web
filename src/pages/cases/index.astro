---
import SiteLayout from "@/src/layouts/SiteLayout.astro";
import { caseSummaries } from "@/lib/content";
import { ConsultCTA } from "@/components/site/coaching-blocks";
const metadata = {
  title: '쇼핑몰·서비스업 온라인 마케팅 실제 사례',
  description: '쇼핑몰의 AI 검색 유입과 구글 검색 기록, 온라인 마케팅 콘텐츠 제작 사례를 소개합니다. 실제 작업 내용과 비교 기간, 숫자를 해석할 때 알아둘 점을 함께 확인하세요.',
};
import { CaseCard } from "@/components/site/case-card";
const listed = caseSummaries.filter(item => item.listed !== false);
---
<SiteLayout {...metadata}>
<main id="main">
    <section class="inner-hero container">
      <p class="eyebrow">실제 사례</p>
      <h1>바꾼 내용과 결과를<br/>실제 자료로 확인하세요.</h1>
      <p class="lead">상품 정보를 정비한 고객 사례와 직접 만든 콘텐츠를 소개합니다.<br/>고객 사례마다 다른 쇼핑몰이며, 업체명은 밝히지 않습니다.<br/>작업 내용, 비교 기간, 숫자를 해석할 때 알아둘 점을 함께 담았습니다.</p>
    </section>
    <section class="container case-group" aria-labelledby="customer-cases-title">
      <div class="case-group-heading"><h2 id="customer-cases-title">고객 사례</h2></div>
      <div class="case-grid">{listed.filter(item => item.category === 'customer').map(item => <CaseCard  item={item}/>)}</div>
    </section>
    <section class="container case-group case-own-group" aria-labelledby="own-cases-title">
      <div class="case-group-heading"><h2 id="own-cases-title">세온비즈가 직접 만든 것</h2><p>코칭에서 알려드리는 방법을 세온비즈 사업에 먼저 적용한 기록입니다.</p></div>
      <div class="case-own-list">{listed.filter(item => item.category === 'self').map(item => <CaseCard  item={item}/>)}</div>
    </section>
    <ConsultCTA/>
  </main>
</SiteLayout>
