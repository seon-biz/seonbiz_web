{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seonbiz-coaching",
  "account_id": "60b42a6ecb45f22b2b3496866eec4338",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "seonbiz.com", "custom_domain": true }
  ],
  "assets": { "html_handling": "drop-trailing-slash" },
  "vars": {
    "CONTACT_EMAIL_FROM": "consultation@forms.seonbiz.com",
    "CONTACT_EMAIL_TO": "cobaltblue872@gmail.com"
  },
  "send_email": [{ "name": "CONTACT_EMAIL", "destination_address": "cobaltblue872@gmail.com" }],
  "ratelimits": [
    { "name": "CONTACT_PHONE_LIMIT", "namespace_id": "260914301", "simple": { "limit": 3, "period": 60 } },
    { "name": "CONTACT_IP_LIMIT", "namespace_id": "260914302", "simple": { "limit": 20, "period": 60 } }
  ]
}
