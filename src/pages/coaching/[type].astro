---
import SiteLayout from "@/src/layouts/SiteLayout.astro";
import { ArrowUpRight, Check } from "lucide-react";
import { coaching } from "@/lib/content";
import { Reveal } from "@/components/site/sections";
import { PricingSummary, FAQ, ConsultCTA } from "@/components/site/coaching-blocks";
import { PageHero } from "@/components/site/page-hero";
import { ServiceProblems, ServiceOwnership } from "@/components/site/service-sections";
export const prerender = true;
export function getStaticPaths(){return [{params:{type:'website'}}];}

const {type}=Astro.params;
const item=coaching[type as keyof typeof coaching];
if(!item)throw new Error("Unknown content route");
const metadata={
  title: '홈페이지 AI 코칭',
  description: '웹사이트를 직접 만들고 관리하려는 분을 위한 일대일 AI 코칭. 홈페이지 제작·수정, SEO·AI 검색 최적화(GEO), GA4·서치콘솔 데이터 분석과 콘텐츠 채널 운영 자동화를 함께합니다.',
};
---
<SiteLayout {...metadata}>
<main id="main" class="service-coaching">
<PageHero eyebrow={item.eyebrow} title={item.title} intro={item.intro} image="/images/service-website.webp" alt="사업 자료와 현장 사진을 홈페이지의 서비스 소개와 문의 안내로 정리하는 일러스트" caption="사업의 실제 정보로 만드는 홈페이지"/>
<ServiceOwnership/>
<ServiceProblems/>
<section class="container task-section"><p class="scope-note">필요한 작업과 순서를 첫 상담에서 정합니다. 홈페이지 제작과 초기 SEO·GEO 설정은 보통 4~8회, 약 1~2개월이 걸리며 페이지 수, 기능, 기존 상태와 준비된 자료에 따라 달라집니다.</p>{item.tasks.map((task,i)=><Reveal><article class="task-row"><div><span class="step-index">0{i+1}</span><h2>{task.title}</h2></div><div><h3>{task.problem}</h3><ul>{task.items.map(t=><li><Check size={18}/>{t}</li>)}</ul><p class="task-result">{task.result}</p></div></article></Reveal>)}</section>
<section class="service-example container"><p class="eyebrow">홈페이지에서 채널 운영까지</p><h2>고객 질문 하나를<br/>여러 채널로 확장합니다.</h2><p>홈페이지에 정확한 답을 먼저 정리한 뒤 블로그 글, SNS 게시물, 유튜브 숏츠에 맞게 나눕니다. 업체에 맞는 AI 지시문과 검토표, 반복 작업 순서를 설정하고 고객이 자기 계정에서 확인해 발행합니다.</p><p class="meta">채널 운영 자동화에는 홈페이지 제작과 별도의 시간이 필요합니다.</p></section>
<section class="container related-case"><p>실제 GA4와 구글 서치콘솔 기록을 확인하세요.</p><p class="service-case-note">서로 다른 고객 웹사이트의 기록이며 특정 수정 하나의 효과를 뜻하지 않습니다.</p><a href="/cases" class="text-link">실제 데이터 보기 <ArrowUpRight size={18}/></a></section>
<section class="container related-case related-note-links" aria-label="관련 코칭 노트"><p>홈페이지 제작과 운영에 필요한 글도 함께 읽어보세요.</p><div><a href="/notes/website-or-agency" class="text-link">홈페이지를 맡길까, 직접 만들까 <ArrowUpRight size={18}/></a><a href="/notes/content-formats" class="text-link">홈페이지 내용을 블로그·SNS·숏츠로 확장하기 <ArrowUpRight size={18}/></a><a href="/notes/ai-search-basics" class="text-link">SEO·AI 검색 최적화 기본 순서 <ArrowUpRight size={18}/></a></div></section>
<PricingSummary/><FAQ client:load/><ConsultCTA title={'만들거나 고치고 싶은\n홈페이지를 알려주세요.'} description="현재 상태와 준비된 자료를 듣고, 홈페이지 제작부터 SEO·GEO와 데이터 분석까지 진행 방향을 함께 정합니다."/>
</main>
</SiteLayout>
