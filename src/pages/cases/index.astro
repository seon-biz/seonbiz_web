---
import SiteLayout from "@/src/layouts/SiteLayout.astro";
import { caseSummaries } from "@/lib/content";
import { ConsultCTA } from "@/components/site/coaching-blocks";
import { CaseCard } from "@/components/site/case-card";
const metadata = {title: 'GA4·구글 서치콘솔 실제 데이터',description: '서로 다른 고객 웹사이트에서 확인한 GA4의 AI 유입과 구글 서치콘솔 검색 기록입니다. 기간과 지표, 해석할 때 알아둘 범위를 함께 설명합니다.'};
---
<SiteLayout {...metadata}>
<main id="main"><section class="inner-hero container"><p class="eyebrow">실제 데이터</p><h1>확인 가능한 기록으로<br/>다음 작업을 정합니다.</h1><p class="lead">GA4의 AI 유입과 구글 서치콘솔 검색 기록을 소개합니다.<br/>세 자료는 서로 다른 고객 웹사이트의 기록이며 숫자를 합쳐 비교하지 않습니다.<br/>특정 수정의 효과나 검색·AI 추천을 보장하는 자료도 아닙니다.</p></section><section class="container case-group" aria-labelledby="data-cases-title"><div class="case-group-heading"><h2 id="data-cases-title">고객 웹사이트의 실제 데이터</h2></div><div class="case-grid">{caseSummaries.map(item => <CaseCard item={item}/>)}</div></section><ConsultCTA/></main>
</SiteLayout>
