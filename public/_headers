/*
  Cache-control for immutable static assets reduces repeat-load latency.
  HTML documents remain revalidated so new deployments appear immediately.
*/
/images/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

/favicon-*
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon-*
  Cache-Control: public, max-age=31536000, immutable
